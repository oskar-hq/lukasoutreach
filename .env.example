# ─────────────────────────────────────────────────────────────────────────────
# Lead-Suche – Konfiguration des Backends
# Kopieren nach .env (wird nie committet):  cp .env.example .env
# Die Schlüssel bleiben im Backend-Container – der Browser sieht sie nie.
# ─────────────────────────────────────────────────────────────────────────────

# Voreinstellung „Max. Profile pro Lauf“ (1–1000). Jedes Profil ist ein Besuch über den LinkedIn-Such-Account.
MAX_RESULTS=15
# Suchtreffer pro Lauf (20–1000, Standard 400): so viele LinkedIn-Treffer gehen durch Dubletten-Filter und
# KI-Vorprüfung (Headline). Kostet Suchseiten (höchstens 200 je Lauf), keine Profilbesuche.
SEARCH_HITS_PER_RUN=400
# Wem neue Leads gehören: owner = wer sucht (Standard) · balanced = auf beide Gründer verteilen (jeder neue Lead an den
# Gründer mit den wenigsten Leads in „Neu“, bei Gleichstand an den Suchenden). Gesucht wird weiter über den
# Such-Account; balanced wirkt nur, wenn UNIPILE_ACCOUNT_NICK und UNIPILE_ACCOUNT_JOHANNES (verschieden) gesetzt sind.
LEAD_DISTRIBUTION=owner

# ── LinkedIn-Suche ──────────────────────────────────────────────────────────

# Unipile: DSN und Access Token stehen im Unipile-Dashboard
UNIPILE_DSN=https://api68.unipile.com:19881
UNIPILE_API_KEY=

# Gescraped wird über ALLE bei Unipile verbundenen LinkedIn-Accounts, je Account und Tag fest höchstens 100 Profile
# und 1000 Suchtreffer (2500 mit Sales Navigator) – Empfehlung von Unipile, nicht änderbar. Diese ID kommt zuerst dran
# (GET /api/v1/accounts); mit sales_navigator den Account MIT Sales Navigator. Vernetzen/Nachrichten nur über die
# Gründer-Accounts (UNIPILE_ACCOUNT_NICK / UNIPILE_ACCOUNT_JOHANNES).
UNIPILE_ACCOUNT_ID=

# classic (normales LinkedIn) oder sales_navigator (nur, wenn der Such-Account Sales Navigator hat)
UNIPILE_SEARCH_API=classic

# Optional: LinkedIn-ID der Region. Leer = wird aus dem Feld „Region“ ermittelt.
UNIPILE_LOCATION_ID=

# Firmenprofil (Beschreibung, Website) zusätzlich abrufen – kostet einen Abruf pro Lead
UNIPILE_FETCH_COMPANY=true

# ── Echte LinkedIn-Aktionen (Vernetzen, Nachrichten) ────────────────────────
# Alles in diesem Abschnitt lässt sich in der Software ändern (Einstellungen → Senden über LinkedIn) – dort auch die
# bei Unipile verbundenen Accounts zur Auswahl, eine Test-Anfrage und „Pause aufheben“. Werte dort gehen vor.
# Aus, bis du on setzt. Jeder Gründer sendet über seinen eigenen bei Unipile verbundenen Account.
LINKEDIN_ACTIONS=off
# Account je Gründer. Auch bei LINKEDIN_ACTIONS=off wichtig: Die Lead-Suche zählt Kontakte und offene Anfragen aller
# hier eingetragenen Accounts als Dubletten (nicht nur die des Such-Accounts).
UNIPILE_ACCOUNT_NICK=
UNIPILE_ACCOUNT_JOHANNES=
# Accounts aufwärmen (kommagetrennte Unipile-Account-IDs, nur reine Scraping-Accounts): schicken nebenbei zu zufälligen
# Zeiten Vernetzungsanfragen ohne Notiz an qualifizierte Leads und Profile der Tracking-Liste. Nur mit LINKEDIN_ACTIONS=on.
UNIPILE_WARMUP_ACCOUNTS=
# Aufwärm-Anfragen je Account und Tag (höchstens 17; in den ersten Wochen 6 → 10 → 14)
LINKEDIN_WARMUP_PER_DAY=17
# Schutz: Anfragen pro Tag und in 7 Tagen, Nachrichten pro Tag (je Account). Fest höchstens 80 / 200 / 100 (Unipile).
LINKEDIN_INVITES_PER_DAY=20
LINKEDIN_INVITES_PER_WEEK=80
LINKEDIN_MESSAGES_PER_DAY=40
# Ist der eigene Account voll, Anfragen über den Account des anderen Gründers senden (on/off, Standard on)
LINKEDIN_ACCOUNT_FALLBACK=on
# Nur zu diesen Zeiten senden (Stunden von-bis, Wochentage 1=Mo … 7=So, z. B. 1-5 oder 1-5,7, Zeitzone)
LINKEDIN_WORK_HOURS=8-19
LINKEDIN_WORK_DAYS=1-5
LINKEDIN_TIMEZONE=Europe/Berlin
# Zufällige Pause zwischen zwei Aktionen eines Accounts (Sekunden von-bis; live gelten immer mindestens 3)
# Nick und Johannes brauchen je einen eigenen Account – bei gleichem Account wird nicht gesendet.
LINKEDIN_PAUSE_SECONDS=3-8
# Angenommene Anfragen und Antworten automatisch abholen, alle n Minuten (0 = aus)
LINKEDIN_SYNC_MINUTES=15

# Anthropic: Schlüssel aus https://console.anthropic.com
# Optional: ohne Schlüssel werden Leads gefunden und angereichert, aber nicht von der KI bewertet.
ANTHROPIC_API_KEY=
# Modell für die Qualifizierung
ANTHROPIC_MODEL=claude-opus-5-5
# Kurs Dollar → Euro für die KI-Kosten im Dashboard und das KI-Tagesbudget der automatischen Suche
AI_USD_EUR_RATE=0.86

# Unter dieser Sicherheit (0–1) gilt ein Lead nie als qualifiziert
QUALIFY_MIN_CONFIDENCE=0.6
# Ohne KI qualifizieren (Komma-Liste; leer = Standard: Projektentwicklung, Projektentwickler, Bauträger, Wohnbau,
# Kapitalanlageimmobilien, Immobilien als Kapitalanlage; „off“ = aus). Nur Entscheider, nie bei Versicherung/Makler/…
# AUTO_QUALIFY_TERMS=

# Meta-Werbebibliothek (Ad Library API): Wer gerade Meta-Ads schaltet, wird aussortiert.
# Optional: ohne Token bleiben qualifizierte Leads „Meta-Ads nicht geprüft“. Token besorgen: siehe README → Meta-Ads-Filter
META_ACCESS_TOKEN=
# Graph-API-Version
META_GRAPH_VERSION=v26.0

# ── Anmeldung ───────────────────────────────────────────────────────────────
# Konten anlegen: docker compose exec backend node dist/server/src/accountsCli.js add nick nick "Nick"
# Sitzungs-Cookie nur über HTTPS (Standard). false NUR ohne HTTPS, z. B. Testserver im Heimnetz über http –
# sonst speichert der Browser das Cookie nicht und die Anmeldung klappt nicht.
AUTH_COOKIE_SECURE=true
# Öffentliche Adresse für Einladungslinks (Konto per Link selbst einrichten), z. B. https://lukas.ylvalabs.de
# Lokal ohne HTTPS (AUTH_COOKIE_SECURE=false) leer lassen → http://localhost:5173
PUBLIC_URL=
# Proxys vor dem Backend (für die echte Client-IP bei der Begrenzung der Fehlversuche): 1 = nginx (Standard, auch mit
# Caddy – nginx prüft selbst, ob die Anfrage von Caddy kam, und gibt genau eine Adresse weiter). 2 aus älteren
# Einrichtungen wirkt wie 1, 0 = keinem Proxy vertrauen.
TRUST_PROXY_HOPS=1
# Erstes Konto nur über den Einrichtungs-Link (Schutz vor Fremden auf einer frischen Installation). Leer = Zufall,
# gespeichert in DATA_DIR/setup-token; den Link zeigt:  docker compose logs backend | grep Einrichtung
# Fester Wert mindestens 24 Zeichen (openssl rand -hex 32), kürzer wird ignoriert (Warnung, dann gilt der Zufall).
#SETUP_TOKEN=

# ── Tagesstapel ─────────────────────────────────────────────────────────────
# Follow-up fällig nach so vielen Tagen ohne Antwort · höchstens so viele Follow-ups
FOLLOWUP_AFTER_DAYS=2
MAX_FOLLOW_UPS=3
# Karten „Neuer Lead“ pro Gründer und Tag im Tagesstapel (passt zum LinkedIn-Tageslimit; begrenzt nicht die
# automatische Suche – die bremsen die Grenzen je LinkedIn-Account) · Anfrage gilt nach so vielen Tagen als hängend
NEW_LEADS_PER_DAY=20
# Notiz zur Vernetzungsanfrage auf der Karte „Neuer Lead“ anbieten: on (Standard) | off (immer ohne Notiz)
INVITE_NOTE=on
INVITE_STALE_DAYS=14

# ── Firmendaten anreichern (Mitarbeiter, Umsatz, Tech-Stack, Social-Links) ──
# Quelle: treg (Standard, Entscheidung 05.10.) oder clay.
ENRICHMENT_PROVIDER=treg
# Treg: Token aus dem Dashboard auf treg.to. Je Firma ein Abruf (ca. 0,2 Cent), Treg probiert bis zu 27 Datenanbieter.
# Leer = aus (live).
TREG_TOKEN=
# Höchstpreis je Abruf in US-Dollar (Treg-Standard wäre 1 $, deshalb hier gedeckelt)
TREG_MAX_COST_USD=0.05

# Übergabe an Close anbieten: on/off. Standard off (wir arbeiten mit dem CRM im Cockpit), in der Simulation on.
CRM_HANDOVER=
# Übergabe heißer Leads an Close (CRM). API-Schlüssel aus Close → Settings → Developer → API Keys.
# Ohne Schlüssel: Leads werden nur im Cockpit als übergeben markiert. Optional: Status neuer Leads in Close (stat_…).
CLOSE_API_KEY=
CLOSE_STATUS_ID=

# Slack-Nachricht bei neuer Antwort (Incoming Webhook, https://hooks.slack.com/…). Leer = keine Nachricht.
SLACK_WEBHOOK_URL=

# Datenschutz: Leads in „Verloren“ nach so vielen Tagen löschen (Standard 30, off = nie).
LOST_DELETE_DAYS=30
# Neue Leads mit Score Hoch/Mittel bei der Übergabe automatisch anreichern (kostet je Abruf). Standard live: false
#ENRICH_AUTO=false
# Höchstens so viele Abrufe pro Tag
ENRICH_MAX_PER_DAY=50

# Nur mit ENRICHMENT_PROVIDER=clay – Einrichtung der Clay-Tabelle: README → Clay.
# Webhook-Adresse der Clay-Tabelle (Clay: „Import data from Webhook“)
CLAY_WEBHOOK_URL=
# Optional: Auth-Token des Clay-Webhooks (wird als x-clay-webhook-auth mitgeschickt)
CLAY_WEBHOOK_TOKEN=
# Geheimer Schlüssel für den Rückweg Clay → Cockpit (mind. 24 Zeichen, z. B. openssl rand -hex 32)
CLAY_CALLBACK_SECRET=
# (CLAY_AUTO_ENRICH / CLAY_MAX_PER_DAY gelten weiter, ENRICH_AUTO / ENRICH_MAX_PER_DAY gehen vor.)

# ── Einstellungen in der Software (Zahnrad im Cockpit) ──────────────────────
# Werte aus der Software gelten vor dieser Datei. Geheimnisse dort liegen verschlüsselt in der Datenbank; der Schlüssel
# dafür ist SETTINGS_KEY (openssl rand -hex 32). Ohne ihn legt das Backend die Datei settings.key im Datenordner an.
# Sicherungen enthalten diesen Schlüssel nicht.
#SETTINGS_KEY=
# Notweg: true = alle Werte aus der Software ignorieren (nur diese Datei gilt)
#SETTINGS_SAFE_MODE=false
# Dauer einer Probe-Änderung (AUTH_COOKIE_SECURE, TRUST_PROXY_HOPS) in Sekunden
#SETTINGS_TRIAL_SECONDS=300

# ── Sicherung der Datenbank ─────────────────────────────────────────────────
# Tägliche Kopie von cockpit.db nach DATA_DIR/backups (im Docker-Volume). Stunde in UTC (2 = 3 bzw. 4 Uhr
# deutscher Zeit) oder off. Sofort sichern, herunterladen, wiederherstellen: Einstellungen → System → Sicherung.
BACKUP_HOUR_UTC=2
# Anzahl aufbewahrter Sicherungen (je Art: geplant, von Hand, vor dem Wiederherstellen)
BACKUP_KEEP=14
# Jede Sicherung (geplant und von Hand) nach so vielen Tagen löschen – die neueste bleibt immer
BACKUP_MAX_AGE_DAYS=7

# ── Software-Updates (Einstellungen → System → Updates, README → Updates) ───
# Auch in der Software (Einstellungen → Sicherung und Updates). Nachts automatisch einspielen (true/false) und zu
# welcher Stunde (0–23, deutsche Zeit).
UPDATE_AUTO=false
UPDATE_HOUR=3
# Update-Dienst – nur ändern, wenn er anders heißt als in docker-compose.yml (Schlüssel legt er selbst an)
#UPDATER_URL=http://updater:8790
#UPDATER_TOKEN_FILE=/shared/updater.token
# Nur nötig, wenn docker compose ohne Shell-Umgebung startet (z. B. mit sudo): Projektordner und Home-Verzeichnis
# des Server-Benutzers (für git-Zugangsdaten). Sonst gelten ${PWD} und ${HOME} der Shell.
#UPDATER_PROJECT_DIR=/root/outreach-cockpit
#UPDATER_GIT_HOME=/root

# Automatische Tests und lokale Entwicklung setzen zusätzlich LEAD_SEARCH_MODE=mock (Simulation ohne Netz, siehe
# playwright.config.ts und scripts/dev-all.mjs). Auf dem Server nie setzen – Standard ist der echte Betrieb.

# ── Nur für einen öffentlichen Server (z. B. VPS) ───────────────────────────
# Start dann mit:  docker compose --profile public up -d --build
# Frontend-Port: Standard 127.0.0.1:8080 (nur intern, von außen nur über Caddy/HTTPS) – so lassen.
# Heimnetz ohne Caddy (z. B. Proxmox): WEB_BIND=8080, dann im ganzen Netz unter http://<IP>:8080.
#WEB_BIND=127.0.0.1:8080
# Domain, die per DNS (A-Eintrag) auf den Server zeigt → automatisch HTTPS. Ohne Domain: :80 (nur HTTP!)
#SITE_ADDRESS=lukas.ylvalabs.de
# TRUST_PROXY_HOPS bleibt 1 (ein vorhandenes 2 stört nicht, es wirkt wie 1)
# Zugang: Konten im Cockpit anlegen (README → „Anmeldung (Konten)“). BASIC_AUTH_* wird nicht mehr gebraucht.
